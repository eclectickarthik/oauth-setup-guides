# Gemini API key, used by the agent to research provider docs (via Google
# Search grounding) and generate guides.
GEMINI_API_KEY=

# Model name for the generation agent, so it can be swapped without a code change.
LLM_MODEL=gemini-flash-lite-latest

# Upstash Redis (optional). If unset, generated guides are stored as local JSON
# files under /data/generated for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
