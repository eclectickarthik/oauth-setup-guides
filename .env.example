# Gemini API key, used to draft the guide JSON from extracted research text.
GEMINI_API_KEY=

# Model name for the generation agent, so it can be swapped without a code change.
LLM_MODEL=gemini-3.5-flash-lite

# Tavily API key, used to search and extract provider developer docs.
# Get one at tavily.com — free tier, no card required.
TAVILY_API_KEY=

# Persistence for generated guides (both optional, checked in this order).
# If neither is set, generated guides are stored as local JSON files under
# /data/generated — fine for local dev, but Vercel's serverless filesystem
# isn't writable/persistent in production, so set one of these for a deploy.

# Preferred: Vercel Blob (`vercel storage create <name> --type blob --access
# private`, then `vercel storage connect <name>` — this sets the var below
# automatically, no manual copy-paste needed).
BLOB_READ_WRITE_TOKEN=

# Alternative: Upstash Redis (vercel.com Marketplace, or upstash.com directly).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Soft access-gate password for the deployed demo (middleware.ts). Defaults
# to "composio" in code if unset — not real security, just keeps the link
# from being stumbled into.
SITE_PASSWORD=
